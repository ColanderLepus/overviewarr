@* The release grid (DESIGN.md section 8): one row per release, a checkbox filter per column. *@

<RadzenDataGrid @ref="Grid" TItem="ReleaseRecord" Data="@Data"
                AllowFiltering="@AllowFiltering" FilterMode="FilterMode.CheckBoxList"
                Filter="@OnFilter" FilterCleared="@OnFilter"
                AllowSorting="true" AllowMultiColumnSorting="true" ShowMultiColumnSortingIndex="true"
                AllowVirtualization="true" AllowColumnPicking="true" AllowColumnResize="true"
                Density="Density.Compact" EmptyText="No releases" Style="height: 65vh" class="release-grid">
    <Columns>
        <RadzenDataGridColumn Width="44px" Sortable="false" Filterable="false" Pickable="false" TextAlign="TextAlign.Center">
            <HeaderTemplate>
                <RadzenCheckBox TValue="bool?" TriState="false" Value="@ShownSelectionState()" Change="@(value => SelectShown(value == true))"
                                InputAttributes="@SelectShownAttributes" />
            </HeaderTemplate>
            <Template Context="release">
                <RadzenCheckBox TValue="bool" Value="@Selection.Contains(release.Key)"
                                Change="@(value => SelectionChanged.InvokeAsync(new SelectionChange([release.Key], value)))"
                                InputAttributes="@SelectOneAttributes" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="44px" Sortable="false" Filterable="false" Pickable="false" TextAlign="TextAlign.Center">
            <Template Context="release">
                @if (FailedReleases.TryGetValue(release.Guid, out var failure))
                {
                    <span class="status-icon failed" title="@FailureTooltip(failure)"><RadzenIcon Icon="error" /></span>
                }
                @if (release.Rejected)
                {
                    <span class="status-icon rejected" title="@RejectionTooltip(release)"><RadzenIcon Icon="block" /></span>
                }
            </Template>
        </RadzenDataGridColumn>

        @* Visible by default, in this order. *@
        <RadzenDataGridColumn Title="Season" Property="@nameof(ReleaseRecord.Seasons)" FilterProperty="@nameof(SeasonTag.Number)"
                              Type="typeof(IEnumerable<SeasonTag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.SeasonSortKey)" Visible="@IsVisible("Season", true)" Width="90px">
            <Template Context="release">@release.SeasonText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Episodes" Filterable="false" SortProperty="@nameof(ReleaseRecord.EpisodesSortKey)"
                              Visible="@IsVisible("Episodes", true)" Width="210px">
            <Template Context="release">
                <span class="episodes">
                    <span>@release.EpisodesText</span>
                    @if (release.SeasonPack)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill="true" Text="Season pack" class="season-pack" />
                    }
                </span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Release group" Property="@nameof(ReleaseRecord.ReleaseGroup)" Visible="@IsVisible("Release group", true)" Width="140px" />
        <RadzenDataGridColumn Title="Quality" Property="@nameof(ReleaseRecord.Quality)" Visible="@IsVisible("Quality", true)" Width="130px" />
        <RadzenDataGridColumn Title="Codec" Property="@nameof(ReleaseRecord.Codec)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.CodecText)" Visible="@IsVisible("Codec", true)" Width="100px">
            <Template Context="release">@release.CodecText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="HDR" Property="@nameof(ReleaseRecord.Hdr)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.HdrText)" Visible="@IsVisible("HDR", true)" Width="120px">
            <Template Context="release">@release.HdrText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Audio format" Property="@nameof(ReleaseRecord.AudioFormat)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.AudioFormatText)" Visible="@IsVisible("Audio format", true)" Width="120px">
            <Template Context="release">@release.AudioFormatText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Audio channels" Property="@nameof(ReleaseRecord.AudioChannels)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.AudioChannelsText)" Visible="@IsVisible("Audio channels", true)" Width="125px">
            <Template Context="release">@release.AudioChannelsText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Streaming service" Property="@nameof(ReleaseRecord.StreamingService)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.StreamingServiceText)" Visible="@IsVisible("Streaming service", true)" Width="130px">
            <Template Context="release">@release.StreamingServiceText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Size per episode" Property="@nameof(ReleaseRecord.SizePerEpisode)" Visible="@IsVisible("Size per episode", true)"
                              FormatString="{0:GB}" FormatProvider="DisplayFormat.Instance" TextAlign="TextAlign.Right" Width="120px" />
        <RadzenDataGridColumn Title="Age" Property="@nameof(ReleaseRecord.Age)" Visible="@IsVisible("Age", true)"
                              FormatString="{0:days}" FormatProvider="DisplayFormat.Instance" TextAlign="TextAlign.Right" Width="90px" />
        <RadzenDataGridColumn Title="Indexer" Property="@nameof(ReleaseRecord.Indexer)" Visible="@IsVisible("Indexer", true)" Width="130px" />

        @* Shown through the column picker. *@
        <RadzenDataGridColumn Title="Season pack" Property="@nameof(ReleaseRecord.SeasonPack)" Visible="@IsVisible("Season pack", false)"
                              FormatString="{0:yesno}" FormatProvider="DisplayFormat.Instance" Width="110px" />
        <RadzenDataGridColumn Title="Source" Property="@nameof(ReleaseRecord.Source)" Visible="@IsVisible("Source", false)" Width="110px" />
        <RadzenDataGridColumn Title="Resolution" Property="@nameof(ReleaseRecord.Resolution)" Visible="@IsVisible("Resolution", false)"
                              TextAlign="TextAlign.Right" Width="100px" />
        <RadzenDataGridColumn Title="Languages" Property="@nameof(ReleaseRecord.Languages)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.LanguagesText)" Visible="@IsVisible("Languages", false)" Width="130px">
            <Template Context="release">@release.LanguagesText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Custom formats" Property="@nameof(ReleaseRecord.CustomFormats)" FilterProperty="@nameof(Tag.Name)"
                              Type="typeof(IEnumerable<Tag>)" FilterOperator="FilterOperator.In"
                              SortProperty="@nameof(ReleaseRecord.CustomFormatsText)" Visible="@IsVisible("Custom formats", false)" Width="160px">
            <Template Context="release">@release.CustomFormatsText</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Custom format score" Property="@nameof(ReleaseRecord.CustomFormatScore)" Visible="@IsVisible("Custom format score", false)"
                              TextAlign="TextAlign.Right" Width="110px" />
        <RadzenDataGridColumn Title="Size" Property="@nameof(ReleaseRecord.Size)" Visible="@IsVisible("Size", false)"
                              FormatString="{0:GB}" FormatProvider="DisplayFormat.Instance" TextAlign="TextAlign.Right" Width="110px" />
        <RadzenDataGridColumn Title="Proper/repack" Property="@nameof(ReleaseRecord.ProperRepack)" Visible="@IsVisible("Proper/repack", false)"
                              FormatString="{0:yesno}" FormatProvider="DisplayFormat.Instance" Width="110px" />
        <RadzenDataGridColumn Title="Rejected by Sonarr" Property="@nameof(ReleaseRecord.Rejected)" Visible="@IsVisible("Rejected by Sonarr", false)"
                              FormatString="{0:yesno}" FormatProvider="DisplayFormat.Instance" Width="110px" />
        <RadzenDataGridColumn Title="Title" Property="@nameof(ReleaseRecord.Title)" Visible="@IsVisible("Title", false)" Width="420px" />
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired] public IEnumerable<ReleaseRecord> Data { get; set; } = [];

    [Parameter] public bool AllowFiltering { get; set; } = true;

    /// <summary>Which columns to show, by title. Columns not listed use their default.</summary>
    [Parameter] public IReadOnlyDictionary<string, bool>? ColumnVisibility { get; set; }

    /// <summary>Raised after a column filter is applied or cleared.</summary>
    [Parameter] public EventCallback FilterChanged { get; set; }

    /// <summary>The page's selection (DESIGN.md section 9).</summary>
    [Parameter, EditorRequired] public IReadOnlySet<ReleaseKey> Selection { get; set; } = new HashSet<ReleaseKey>();

    [Parameter] public EventCallback<SelectionChange> SelectionChanged { get; set; }

    /// <summary>Failed downloads by release <c>guid</c> (DESIGN.md section 10).</summary>
    [Parameter] public IReadOnlyDictionary<string, FailedDownload> FailedReleases { get; set; } = new Dictionary<string, FailedDownload>();

    public RadzenDataGrid<ReleaseRecord>? Grid { get; private set; }

    private static readonly Dictionary<string, object> SelectShownAttributes = new() { ["aria-label"] = "Select every release shown" };
    private static readonly Dictionary<string, object> SelectOneAttributes = new() { ["aria-label"] = "Select release" };

    /// <summary>The releases the grid shows, with its column filters and sort applied.</summary>
    private List<ReleaseRecord> Shown() => Grid is null ? Data.ToList() : Grid.View.ToList();

    /// <summary>Unticked when none of the shown releases is selected, ticked when all are, otherwise partly ticked.</summary>
    private bool? ShownSelectionState()
    {
        var shown = Shown();
        var selected = shown.Count(r => Selection.Contains(r.Key));
        return selected == 0 ? false : selected == shown.Count ? true : null;
    }

    private Task SelectShown(bool select) =>
        SelectionChanged.InvokeAsync(new SelectionChange(Shown().Select(r => r.Key).ToList(), select));

    /// <summary>The grid's current column visibility, by title.</summary>
    public IReadOnlyDictionary<string, bool> CurrentColumnVisibility() =>
        Grid?.ColumnsCollection.Where(c => !string.IsNullOrEmpty(c.Title)).ToDictionary(c => c.Title, c => c.GetVisible())
        ?? new Dictionary<string, bool>();

    /// <summary>Applies this grid's column filters to releases, the same way the grid does.</summary>
    public IReadOnlyList<ReleaseRecord> ApplyColumnFilters(IReadOnlyList<ReleaseRecord> releases) =>
        Grid is null ? releases : releases.AsQueryable().Where(Grid.ColumnsCollection).ToList();

    private bool IsVisible(string title, bool byDefault) =>
        ColumnVisibility is not null && ColumnVisibility.TryGetValue(title, out var visible) ? visible : byDefault;

    private Task OnFilter(DataGridColumnFilterEventArgs<ReleaseRecord> _) => FilterChanged.InvokeAsync();

    private static string FailureTooltip(FailedDownload failure) =>
        string.IsNullOrWhiteSpace(failure.Message) ? "Download failed" : $"Download failed: {failure.Message}";

    private static string RejectionTooltip(ReleaseRecord release) =>
        "Rejected by Sonarr:\n" + string.Join("\n", release.Rejections.Select(r => "• " + r));
}
